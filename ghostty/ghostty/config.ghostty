config-file = themes/rosepine
font-family = "BlexMono Nerd Font Mono"
background = "#11111B"
background-opacity = 0.8
foreground = "#CDD6F4"
adjust-cursor-thickness = 2
window-decoration = false
gtk-titlebar = false
font-style = Regular
font-style-bold = Bold
font-style-italic = Regular
font-style-bold-italic = Bold
font-synthetic-style = false
font-size = 16
mouse-hide-while-typing = true
macos-titlebar-proxy-icon = hidden
title = " "
clipboard-write = allow
# custom-shader = ~/.config/ghostty/shaders/cursor.glsl
# background-image = ~/Wall/core/anime_girl_on_blue_background.png
# background-image-fit = cover
# background-image-opacity = 0.02
